# Ejemplo de variables de entorno — SOLO NOMBRES, nunca valores reales.
# Los valores se ponen en el .env de cada servidor al desplegar, con la autorización de Nicolás Rivera.

# ---------------------------------------------------------------------------
# Módulo «Correo» (lib/correo/config.ts)
# Graph con la app de APLICACIÓN del inquilino (decisión de Nicolás, 2026-10-15). El buzón
# SIEMPRE es el del usuario de la sesión (lib/correo/graph.ts → mailboxForSession).
# ---------------------------------------------------------------------------
# off (por defecto) | mock (buzón simulado para pruebas) | graph (buzón real)
CORREO_MODO=off
# Inquilinos habilitados, separados por coma. Fase 1: solo gss.
CORREO_INQUILINOS=gss
# App del conector mcp-sharepoint-gss (inquilino GSS). Mismo id/secreto que SP_* de ese conector.
CORREO_GSS_TENANT_ID=
CORREO_GSS_CLIENT_ID=
CORREO_GSS_CLIENT_SECRET=
# Dominios de correo que atiende ese inquilino (coma).
CORREO_GSS_DOMINIOS=gsslatam.com
# Responder desde SynerLink (Mail.Send) y categoría «SynerLink #N» en Outlook (Mail.ReadWrite).
CORREO_ENVIO_HABILITADO=true
CORREO_ETIQUETAR_HABILITADO=true
# Tarea de fondo: correos nuevos de hilos vinculados → notas del caso. APAGADA hasta aprobación.
CORREO_SYNC_HABILITADO=false
# «Consultar a un agente» (botón del hilo, /api/correo/agente/** y herramientas correo_* de kronos-mcp).
# APAGADO hasta la aprobación de Gobierno IA. kronos-mcp la toma de este mismo .env (prefijo CORREO_).
CORREO_AGENTE_HABILITADO=false
