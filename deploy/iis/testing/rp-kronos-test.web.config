<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config del sitio IIS de PRUEBAS "rp-kronos-test" (https :8450,
  kronos-test.gsslatam.com, carpeta C:\inetpub\testrp\rp-kronos-test) en la .230.
  Variante de deploy/iis/web.config (prod): misma lógica de mantenimiento, pero el
  proxy va a GSS-Front-TEST (:3030) y conserva X-Forwarded-Proto=https, como la
  regla original del sitio. Fuente: deploy/iis/testing/rp-kronos-test.web.config
  en AnalistaSistemasFarma/front-kronos. Lo instala scripts/iis-setup-maintenance.ps1
  (con respaldo previo); no lo edite a mano en el servidor.

  Capas:
    (a) Mantenimiento planificado: si existe <carpeta del sitio>\mantenimiento.flag,
        IIS responde 503 + Retry-After y muestra _mantenimiento/index.html sin
        pasar por Node. Excepciones: la propia página, /api/health/* y las
        peticiones desde el mismo servidor (127.0.0.1 / ::1).
    (b) Respaldo ante caída: si Node no responde, ARR genera 502.3 (o IIS un 503)
        y httpErrors muestra la MISMA página. Los 5xx que devuelve la app con
        cuerpo pasan intactos (existingResponse="Auto").

  Requisito a nivel de servidor (lo aplica el script, va en applicationHost.config):
    allowedServerVariables debe incluir RESPONSE_Retry_After para este sitio.
    Sin eso, la regla de mantenimiento responde 500.50 mientras exista la bandera.

  IMPORTANTE: active/desactive SIEMPRE con scripts\maintenance-on.ps1 / -off.ps1,
  no creando o borrando la bandera a mano. URL Rewrite guarda en cache, por URL,
  el resultado de la condicion IsFile; los scripts tocan este web.config para
  vaciar esa cache. Si se crea la bandera a mano, las URLs ya visitadas seguiran
  yendo a Node (y al borrarla a mano, seguiran mostrando la pagina).
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 1. Recursos de la página de mantenimiento: siempre los sirve IIS. -->
                <rule name="Mantenimiento - recursos propios" stopProcessing="true">
                    <match url="^_mantenimiento/" />
                    <action type="None" />
                </rule>
                <!-- 2. Bandera de mantenimiento planificado. -->
                <rule name="Mantenimiento - bandera" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{APPL_PHYSICAL_PATH}mantenimiento.flag" matchType="IsFile" />
                        <add input="{REMOTE_ADDR}" pattern="^(127\.0\.0\.1|::1)$" negate="true" />
                        <add input="{URL}" pattern="^/api/health/" negate="true" />
                    </conditions>
                    <serverVariables>
                        <set name="RESPONSE_Retry_After" value="120" />
                    </serverVariables>
                    <action type="CustomResponse" statusCode="503" subStatusCode="0" statusReason="Service Unavailable" statusDescription="SynerLink se esta actualizando" />
                </rule>
                <!-- 3. Proxy inverso hacia GSS-Front-TEST (PM2, :3030). Regla original del sitio. -->
                <rule name="ReverseProxyToApp" stopProcessing="true">
                    <match url="(.*)" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                    </serverVariables>
                    <action type="Rewrite" url="http://localhost:3030/{R:1}" />
                </rule>
            </rules>
        </rewrite>
        <!--
          existingResponse="Auto": si la respuesta ya trae cuerpo (p. ej. un 500 o
          503 que genera Next.js), IIS la deja pasar; solo reemplaza los errores
          que genera IIS/ARR (502.3 con Node abajo, el 503 de la regla 2).
          errorMode se hereda (DetailedLocalOnly): desde el propio servidor se ve
          el error detallado de IIS; desde afuera, esta página.
          responseMode="File" (no ExecuteURL): con ExecuteURL IIS devolvía la
          página con HTTP 200; con File conserva el 502/503 (probado en la .230).
          La ruta es relativa a la carpeta del sitio (allowAbsolutePathsWhenDelegated=false).
        -->
        <httpErrors existingResponse="Auto">
            <remove statusCode="502" subStatusCode="-1" />
            <remove statusCode="503" subStatusCode="-1" />
            <error statusCode="502" subStatusCode="-1" path="_mantenimiento\index.html" responseMode="File" />
            <error statusCode="503" subStatusCode="-1" path="_mantenimiento\index.html" responseMode="File" />
        </httpErrors>
    </system.webServer>
    <location path="_mantenimiento">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
