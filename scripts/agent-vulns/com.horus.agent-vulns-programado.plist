<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Escáner de vulnerabilidades OSV (Auditoría de agentes → Vulnerabilidades). Pedido de Nicolás 2026-11-19.
       programado: cada 6 horas, escaneo completo.
       Copia instalada en ~/.horus/agent-vulns/ (fuente: front-kronos scripts/agent-vulns/). Solo lectura de GitHub (gh) y OSV.
       Destinos: AGENT_VULNS_CONF (por ahora solo PRUEBAS; agregar collector-prod.env tras el pase). -->
  <key>Label</key><string>com.horus.agent-vulns-programado</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>/Users/horus/.horus/agent-vulns/escaner.py</string><string>--programado</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/horus</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>AGENT_VULNS_CONF</key><string>/Users/horus/.horus/agent-inventory/collector.env</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/horus/.horus/agent-vulns/logs/programado.out.log</string>
  <key>StandardErrorPath</key><string>/Users/horus/.horus/agent-vulns/logs/programado.err.log</string>
</dict>
</plist>
