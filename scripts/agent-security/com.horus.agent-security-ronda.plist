<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Analizador de SEGURIDAD de conversaciones (Auditoría de agentes → Análisis de seguridad).
       Pedido de Nicolás 2026-11-05. Cada 5 min: solo trabaja si alguien pulsó «Analizar».
       Lee en SOLO LECTURA las conversaciones del ambiente de cada destino y publica los hallazgos.
       Copia instalada en ~/.horus/agent-security/ (fuente: front-kronos scripts/agent-security/).
       Destinos: AGENT_SECURITY_CONF (PRUEBAS y PRODUCCIÓN, separados por «:»). -->
  <key>Label</key><string>com.horus.agent-security-ronda</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/horus/.horus/agent-security/analizador.py</string>
    <string>--ronda</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/horus</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/horus/.local/bin</string>
    <key>AGENT_SECURITY_CONF</key><string>/Users/horus/.horus/agent-inventory/collector.env:/Users/horus/.horus/agent-inventory/collector-prod.env</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/horus/.horus/agent-security/logs/ronda.out.log</string>
  <key>StandardErrorPath</key><string>/Users/horus/.horus/agent-security/logs/ronda.err.log</string>
</dict>
</plist>
