<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.horus.agent-errors</string>
  <!-- Recolector de errores de IA (Auditoría → Errores de IA), 2026-11-03.
       PREPARADO, NO CARGADO. Instalación (Mac de horus):
         mkdir -p ~/.horus/agent-errors/logs
         cp scripts/agent-errors/recolector_errores.py ~/.horus/agent-errors/
         cp scripts/agent-errors/com.horus.agent-errors.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.horus.agent-errors.plist
       Destino: PRUEBAS (collector.env). Para sumar producción, agregar en
       ProgramArguments la opción conf dos veces: collector.env y
       collector-prod.env de ~/.horus/agent-inventory (rutas absolutas).
       Retiro: launchctl bootout gui/$(id -u)/com.horus.agent-errors y renombrar el plist. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/perl</string><string>-e</string><string>alarm 840; exec @ARGV</string>
    <string>/usr/bin/python3</string>
    <string>/Users/horus/.horus/agent-errors/recolector_errores.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/horus</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <!-- cada 15 minutos -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/horus/.horus/agent-errors/logs/recolector.out.log</string>
  <key>StandardErrorPath</key><string>/Users/horus/.horus/agent-errors/logs/recolector.err.log</string>
</dict>
</plist>
