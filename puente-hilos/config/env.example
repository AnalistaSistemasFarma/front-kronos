# Puente de hilos — PRUEBAS. Copie a ~/.puente-hilos/play-pruebas/.env (chmod 600).
# SOLO NOMBRES aquí; los valores nunca van al repositorio.
# 'pruebas' o 'produccion'. Producción va en OTRA instancia (~/.puente-hilos/<agente>-prod,
# servicio com.gss.puente-hilos.<agente>-prod, llave <agente>-hilos-prod); ver README «Producción».
HILOS_ENTORNO=pruebas
HILOS_SYNERLINK_URL=
# Solo con HILOS_ENTORNO=produccion: la misma URL, escrita otra vez (si no coincide, no arranca).
HILOS_CONFIRMAR_URL_PRODUCCION=
# Llave NUEVA del agente con scope "projects" (no la del bot vivo de Play).
HILOS_SYNERLINK_KEY=
HILOS_AGENTE=play
HILOS_DIR=
HILOS_PERFILES=
# EXACTAMENTE una de las tres. Decisión de Nicolás (2026-10-17): el token del propio agente.
# Ruta al .env del bot (p. ej. /Users/pedro/.play/.env): el puente lee SOLO CLAUDE_CODE_OAUTH_TOKEN.
HILOS_TOKEN_ENV_AGENTE=
HILOS_CLAUDE_CODE_OAUTH_TOKEN=
HILOS_ANTHROPIC_API_KEY=
HILOS_MAX_CONCURRENCIA=2
# Tope DURO por turno (ms). 3600000 = 60 min (por defecto y máximo). Ver README «Turnos largos».
HILOS_TIMEOUT_TURNO_MS=3600000
# Aviso «sigo trabajando» en el hilo mientras el turno corre (ms; 0/off lo apaga). 600000 = 10 min.
HILOS_AVISO_PROGRESO_MS=600000
# 'si': al agotarse el tiempo, UNA continuación automática sobre la misma sesión. 'no' por defecto.
HILOS_CONTINUAR_AL_AGOTAR=no
HILOS_MODELO=
# Tope de gasto por pedido (USD). 0 u off = SIN TOPE (tampoco con equipo); el gasto se sigue registrando.
HILOS_MAX_BUDGET_USD=0
HILOS_CLAUDE_BIN=
HILOS_INSTRUCCIONES_EN=system-prompt
# Equipo de subagentes (F2, 2026-10-18; ver README «Equipo de subagentes»). Valores por defecto:
# 'no' apaga el equipo en TODOS los turnos de este puente (interruptor de emergencia).
HILOS_SUBAGENTES=si
# Subagentes a la vez por turno (1 a 5). El proyecto puede bajarlo, nunca subirlo.
HILOS_SUBAGENTES_MAX_SIMULTANEOS=3
# Vueltas máximas de cada subagente.
HILOS_SUBAGENTES_MAX_TURNOS=30
# Tope de gasto POR PEDIDO cuando el turno lleva equipo (--max-budget-usd). No aplica con HILOS_MAX_BUDGET_USD=0/off.
HILOS_SUBAGENTES_PRESUPUESTO_USD=3
# «Sugerir equipo»: tope de gasto y de tiempo.
HILOS_SUGERENCIA_PRESUPUESTO_USD=0.5
HILOS_SUGERENCIA_TIMEOUT_MS=180000
# Acceso al código (nivel 2, 2026-10-20; ver README «Acceso al código»). Opcional: sin estas dos, ningún proyecto tiene código.
# Ruta ABSOLUTA a repos-por-proyecto.json (se relee en cada turno). Ejemplo: config/repos-por-proyecto.example.json
HILOS_REPOS_POR_PROYECTO=
# Ruta ABSOLUTA a un archivo 600 con el token de GitHub (entra al modelo como GH_TOKEN solo en turnos con código).
HILOS_GITHUB_TOKEN_ARCHIVO=
# Memoria del bot principal en SOLO LECTURA (2026-10-20; ver README «Memoria del agente»). Opcional.
# Ruta ABSOLUTA al directorio memory/ del bot (MEMORY.md + archivos). Se copia en cada turno a .puente/memoria.
HILOS_MEMORIA_DIR=
# Correos (coma) cuyos turnos reciben la memoria. Vacío = todos los miembros del proyecto.
HILOS_MEMORIA_LECTORES=
# Conectores de bases en SOLO LECTURA por proyecto (2026-10-20; ver README «Bases de datos por proyecto»). Opcional.
# Ruta ABSOLUTA a conectores-por-proyecto.json (se relee en cada turno).
HILOS_CONECTORES_POR_PROYECTO=
# Ruta ABSOLUTA a un archivo 600 { "<llave>": "<Bearer sin prefijo>" }; solo lo lee el headersHelper.
HILOS_CONECTORES_SECRETOS=
# Skills por --plugin-dir (2026-10-21; ver README «Skills, recursos y PDF»). Lista de rutas ABSOLUTAS separadas por coma.
# Ejemplo: /Users/horus/.puente-hilos/plugins/graphify,/Users/horus/.puente-hilos/plugins/gss-design
# Si un plugin tiene carpeta recursos/, se monta en SOLO LECTURA en todos los turnos y Chrome la puede leer al hacer PDF.
HILOS_PLUGIN_DIRS=
# Grafos de Graphify ya construidos (<dir>/<repo>/graphify-out). Opcional.
HILOS_GRAFOS_DIR=
# HTML → PDF en el puente (líneas «PDF:trabajo/….html»). «si» por defecto; «no» lo apaga.
HILOS_PDF=si
# Binario ABSOLUTO de chrome-headless-shell. Vacío = el más nuevo de ~/Library/Caches/ms-playwright.
HILOS_PDF_CHROME=
# Tiempo máximo por conversión, en ms (10000 a 180000; 60000 por defecto).
HILOS_PDF_TIMEOUT_MS=
