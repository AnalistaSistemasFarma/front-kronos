# Puente de hilos — PRUEBAS. Copie a ~/.puente-hilos/play-pruebas/.env (chmod 600).
# SOLO NOMBRES aquí; los valores nunca van al repositorio.
HILOS_ENTORNO=pruebas
HILOS_SYNERLINK_URL=
# Llave NUEVA del agente con scope "projects" (no la del bot vivo de Play).
HILOS_SYNERLINK_KEY=
HILOS_AGENTE=play
HILOS_DIR=
HILOS_PERFILES=
# EXACTAMENTE una de las dos. Recomendada para escalar: llave de API.
HILOS_ANTHROPIC_API_KEY=
HILOS_CLAUDE_CODE_OAUTH_TOKEN=
HILOS_MAX_CONCURRENCIA=2
HILOS_TIMEOUT_TURNO_MS=900000
HILOS_MODELO=
HILOS_MAX_BUDGET_USD=
HILOS_CLAUDE_BIN=
HILOS_INSTRUCCIONES_EN=system-prompt
