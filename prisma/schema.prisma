generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  // Varios esquemas SQL (multiSchema, GA en Prisma 6): todo lo existente vive
  // en `dbo`; el Sistema de Gestión de Calidad (SGC) documental vive aislado
  // en su propio esquema `sgc` (decisión de Nicolás, 2026-09-30). Por eso cada
  // modelo declara su @@schema; los de `dbo` no cambian de tabla ni de datos.
  schemas           = ["dbo", "sgc"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCases     Case[]  @relation("TechnicalAccount")

  @@unique([provider, providerAccountId])
  @@map("account")
  @@schema("dbo")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@schema("dbo")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  createdAt               DateTime                 @default(now())
  isActive                Boolean                  @default(true)
  role                    String                   @default("user")
  phone                   String?
  identification          String?
  // NIT del proveedor. Solo lo tienen los usuarios con role = "supplier" (proveedores
  // externos que ingresan por /proveedor/login). Es el identificador con el que se
  // scopea TODA su información del lado del servidor. Nullable porque los usuarios
  // internos no tienen NIT. La unicidad se garantiza con un índice ÚNICO FILTRADO
  // (WHERE nit IS NOT NULL) creado en la migración; no se declara @unique aquí porque
  // SQL Server solo admite un único NULL en un índice único no filtrado.
  nit                     String?
  id_user_sapsend         Int?
  themePalette            String?                  @default("gss")
  colorScheme             String?                  @default("light")
  // Tipografía elegida por el usuario. Es una CLAVE del catálogo de
  // lib/theme/fonts.ts, no una cadena CSS: así el valor que llega de la base
  // nunca puede inyectar CSS arbitrario en :root.
  uiFont                  String?                  @default("sistema")
  accounts                Account[]
  companyUsers            CompanyUser[]
  departmentUsers         DepartmentUser[]
  userTypesAuthorizations UserTypesAuthorization[]
  sessions                Session[]
  auditLogs               UserAuditLog[]
  // Modulo "Asistentes IA" (chat de agentes) — back-relations requeridas por Prisma.
  chatConversations       ChatConversation[]       @relation("ChatConversationUser")
  chatGroupsCreated       ChatConversation[]       @relation("ChatConversationCreator")
  chatParticipations      ChatParticipant[]
  chatMessagesAuthored    ChatMessage[]            @relation("ChatMessageUserAuthor")
  chatPins                ChatPin[]

  @@map("user")
  @@schema("dbo")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
  @@schema("dbo")
}

model Company {
  id_company      Int                @id @default(autoincrement())
  company         String
  company_logo    String?
  companyUsers    CompanyUser[]
  sap_endpoints   sap_endpoints[]
  cargoAliases    CargoAlias[]
  cargoJerarquias CargoJerarquia[]
  // Modulo "Asistentes IA" (chat de agentes) — back-relations requeridas por Prisma.
  agentCompanies  AgentCompany[]
  chatGroups      ChatConversation[]
  // SGC documental — configuración de activación por empresa (esquema `sgc`).
  sgcCompanyConfig SgcCompanyConfig?

  @@map("company")
  @@schema("dbo")
}

model CompanyUser {
  id_company_user Int                     @id @default(autoincrement())
  id_company      Int
  id_user         String
  company         Company                 @relation(fields: [id_company], references: [id_company], onDelete: Cascade)
  user            User                    @relation(fields: [id_user], references: [id], onDelete: Cascade)
  subprocesses    SubprocessUserCompany[]

  @@map("company_user")
  @@schema("dbo")
}

model Process {
  id_process   Int          @id @default(autoincrement())
  process      String
  process_url  String?
  subprocesses Subprocess[]

  @@map("process")
  @@schema("dbo")
}

model Subprocess {
  id_subprocess           Int                     @id @default(autoincrement())
  subprocess              String
  id_process              Int
  subprocess_url          String?
  process                 Process                 @relation(fields: [id_process], references: [id_process], onDelete: Cascade)
  subprocessUserCompanies SubprocessUserCompany[]
  // Modulo "Asistentes IA" (chat de agentes) — back-relation requerida por Prisma.
  agents                  Agent[]

  @@map("subprocess")
  @@schema("dbo")
}

model SubprocessUserCompany {
  id_subprocess_user_company Int         @id @default(autoincrement())
  id_subprocess              Int
  id_company_user            Int
  companyUser                CompanyUser @relation(fields: [id_company_user], references: [id_company_user], onDelete: Cascade)
  subprocess                 Subprocess  @relation(fields: [id_subprocess], references: [id_subprocess], onDelete: Cascade)

  @@map("subprocess_user_company")
  @@schema("dbo")
}

model UserAuditLog {
  id_audit_log Int      @id @default(autoincrement())
  user_id      String
  action       String
  performed_by String
  details      String?  @db.Text
  created_at   DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_audit_log")
  @@schema("dbo")
}

model StatusCase {
  id_status_case Int    @id @default(autoincrement())
  status         String @unique
  cases          Case[]

  @@map("status_case")
  @@schema("dbo")
}

model Active {
  id_active   Int    @id @default(autoincrement())
  name        String @unique
  Renamedcase Case[]

  @@map("active")
  @@schema("dbo")
}

model Department {
  id_department   Int              @id @default(autoincrement())
  department      String           @unique
  cases           Case[]
  departmentUsers DepartmentUser[]
  // SGC documental (esquema `sgc`) — back-relations requeridas por Prisma; no cambian dbo.department.
  sgcProcesses        SgcProcessMap[]
  sgcOwnedDocuments   SgcDocument[]
  sgcDocumentAccesses SgcDocumentAccess[]

  @@map("department")
  @@schema("dbo")
}

model DepartmentUser {
  id            Int        @id @default(autoincrement())
  id_user       String
  id_department Int
  user          User       @relation(fields: [id_user], references: [id])
  department    Department @relation(fields: [id_department], references: [id_department])

  @@map("department_user")
  @@schema("dbo")
}

model TypesAuthorization {
  id                 Int                      @id @default(autoincrement())
  type_authorization String
  userTypes          UserTypesAuthorization[]

  @@map("types_authorization")
  @@schema("dbo")
}

model UserTypesAuthorization {
  id                 Int                @id @default(autoincrement())
  type_authorization Int
  id_user            String
  typeAuthorization  TypesAuthorization @relation(fields: [type_authorization], references: [id])
  user               User               @relation(fields: [id_user], references: [id])

  @@map("user_types_authorization")
  @@schema("dbo")
}

model Category {
  id_category   Int            @id @default(autoincrement())
  category      String         @unique
  categoryCase  CategoryCase[]
  subcategories Subcategory[]

  @@map("category")
  @@schema("dbo")
}

model Subcategory {
  id_subcategory Int            @id @default(autoincrement())
  subcategory    String         @unique
  id_category    Int?
  activities     Activity[]
  categoryCase   CategoryCase[]
  category       Category?      @relation(fields: [id_category], references: [id_category], onDelete: NoAction, onUpdate: NoAction, map: "FK__subcatego__id_ca__0D7A0286")

  @@map("subcategory")
  @@schema("dbo")
}

model Activity {
  id_activity    Int            @id @default(autoincrement())
  activity       String
  id_subcategory Int?
  subcategory    Subcategory?   @relation(fields: [id_subcategory], references: [id_subcategory], onDelete: NoAction, onUpdate: NoAction, map: "FK__activity__id_sub__0E6E26BF")
  categoryCase   CategoryCase[] @relation("CategoryCaseActive")

  @@map("activity")
  @@schema("dbo")
}

model Case {
  id_case          Int               @id @default(autoincrement())
  description      String            @db.Text
  id_status_case   Int
  subject_case     String
  creation_date    DateTime          @default(now())
  resolution       String?           @db.Text
  end_date         DateTime?
  id_technical     String
  requester        String
  id_active        Int?
  place            String?
  id_department    Int
  case_type        String
  priority         String
  email            String?           @db.NVarChar(255)
  active           Active?           @relation(fields: [id_active], references: [id_active], onDelete: NoAction)
  department       Department        @relation(fields: [id_department], references: [id_department])
  statusCase       StatusCase        @relation(fields: [id_status_case], references: [id_status_case])
  technicalAccount Account           @relation("TechnicalAccount", fields: [id_technical], references: [id], onUpdate: NoAction)
  categoryCase     CategoryCase[]
  logs             LogCaseHelpDesk[]
  notes            Note[]

  @@map("case")
  @@schema("dbo")
}

model CategoryCase {
  id_category_case Int         @id @default(autoincrement())
  id_case          Int
  id_category      Int
  id_subcategory   Int
  id_activity      Int
  case             Case        @relation(fields: [id_case], references: [id_case], onDelete: Cascade)
  category         Category    @relation(fields: [id_category], references: [id_category], onUpdate: NoAction)
  subcategory      Subcategory @relation(fields: [id_subcategory], references: [id_subcategory], onUpdate: NoAction)
  activity         Activity    @relation("CategoryCaseActive", fields: [id_activity], references: [id_activity], onUpdate: NoAction, map: "fk_category_case_active")

  @@map("category_case")
  @@schema("dbo")
}

model Note {
  id_note Int    @id @default(autoincrement())
  id_case Int
  note    String @db.Text
  case    Case   @relation(fields: [id_case], references: [id_case], onDelete: Cascade)

  @@map("notes")
  @@schema("dbo")
}

model LogCaseHelpDesk {
  id_log  Int    @id @default(autoincrement())
  id_case Int
  log     String @db.Text
  case    Case   @relation(fields: [id_case], references: [id_case], onDelete: Cascade)

  @@map("logs_case_help_desk")
  @@schema("dbo")
}

model sap_endpoints {
  id_sap_endpoint               Int      @id @default(autoincrement())
  id_company                    Int
  endpoint_name                 String
  base_url                      String
  username                      String?
  password                      String?
  client                        String?
  is_active                     Boolean  @default(true)
  created_at                    DateTime @default(now())
  updated_at                    DateTime
  // Nombre del UDO de registros sanitarios en la base SAP de esta empresa.
  // Varía por empresa (ej. FAR_RegiSanitario en Farmalogica, prefijo distinto en otras),
  // por eso se mapea aqui en vez de asumir un nombre fijo. Null = la empresa no tiene el modulo.
  health_records_entity         String?
  health_records_log_collection String?
  // Nombre del UDO de bitácora de cambios de artículos en la base SAP de esta
  // empresa (ej. ART_CHG_LOG en OLP). Null = la empresa no registra el log.
  articles_log_object           String?
  company                       Company  @relation(fields: [id_company], references: [id_company], onDelete: Cascade)
  @@schema("dbo")
}

// === Módulo Organigrama (SynerLink) ===
// Catálogo maestro de cargos del grupo. Usa un id estable + tabla de alias
// (CargoAlias) para que renombrar un cargo no rompa la historia (Farmalógica
// migra Direcciones→Gerencias; Ryan acumula 22 versiones de cambios de cargo).
model Cargo {
  id_cargo           Int              @id @default(autoincrement())
  nombre_normalizado String           @unique
  // Estratégico / Táctico / Operativo
  nivel              String?
  // Gerencia / Dirección / Jefatura / Coordinación / Analista / Auxiliar / Profesional / Técnico
  nivel_clasico      String?
  is_active          Boolean          @default(true)
  created_at         DateTime         @default(now())
  aliases            CargoAlias[]
  // Jerarquías donde este cargo es el subordinado
  jerarquias         CargoJerarquia[] @relation("CargoSubordinado")
  // Jerarquías donde este cargo es el padre/jefe
  jerarquiasHijas    CargoJerarquia[] @relation("CargoPadre")

  @@map("cargo")
  @@schema("dbo")
}

// Nombres históricos y variantes de un cargo (p.ej. "Director X" ↔ "Gerente X").
// id_company nulo = alias global; con valor = alias específico de esa empresa.
model CargoAlias {
  id_cargo_alias Int      @id @default(autoincrement())
  id_cargo       Int
  alias          String
  id_company     Int?
  created_at     DateTime @default(now())
  cargo          Cargo    @relation(fields: [id_cargo], references: [id_cargo], onDelete: Cascade)
  company        Company? @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)

  @@map("cargo_alias")
  @@schema("dbo")
}

// Jerarquía de reporte POR EMPRESA: el mismo cargo reporta distinto en
// Farmalógica vs Ryan. id_cargo_padre nulo = raíz (Junta / Gerente General).
// aproximada = el organigrama no permite inferir el parent con certeza.
model CargoJerarquia {
  id_cargo_jerarquia Int      @id @default(autoincrement())
  id_company         Int
  id_cargo           Int
  id_cargo_padre     Int?
  aproximada         Boolean  @default(false)
  created_at         DateTime @default(now())
  company            Company  @relation(fields: [id_company], references: [id_company], onDelete: Cascade)
  cargo              Cargo    @relation("CargoSubordinado", fields: [id_cargo], references: [id_cargo], onDelete: NoAction, onUpdate: NoAction)
  cargoPadre         Cargo?   @relation("CargoPadre", fields: [id_cargo_padre], references: [id_cargo], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_company, id_cargo])
  @@map("cargo_jerarquia")
  @@schema("dbo")
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B612B2C881E") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
  @@schema("dbo")
}

// ===================================================================
// Constructor de Vistas SQL (Fase 1) — modelos de las tablas ya
// existentes en la BD (saved_view, saved_view_column, catalog_source,
// catalog_field). Ver propuesta técnica §3.
// ===================================================================

model SavedView {
  id_saved_view    Int       @id @default(autoincrement())
  name             String    @db.NVarChar(150)
  slug             String    @unique @db.NVarChar(160)
  description      String?   @db.NVarChar(1000)
  sql_text         String    @db.NVarChar(Max)
  id_process       Int?
  scope_mode       String    @default("company") @db.NVarChar(20)
  company_id_fixed Int?
  company_column   String?   @db.NVarChar(128)
  visibility       String    @default("published") @db.NVarChar(20)
  icon             String?   @db.NVarChar(60)
  sort_order       Int       @default(0)
  owner_user_id    String    @db.NVarChar(1000)
  row_limit        Int       @default(1000)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  published_at     DateTime?

  columns SavedViewColumn[]
  filters SavedViewFilter[]

  @@map("saved_view")
  @@schema("dbo")
}

// Filtros parametrizables de una vista publicada (Incremento 3, §3).
// Los define el autor; el consumidor los usa desde la galería. El backend
// construye un WHERE externo parametrizado SOLO a partir de estas definiciones.
model SavedViewFilter {
  id_saved_view_filter Int       @id @default(autoincrement())
  id_saved_view        Int
  column_name          String    @db.NVarChar(128)
  label                String    @db.NVarChar(150)
  filter_type          String    @db.NVarChar(20)
  operator             String    @db.NVarChar(20)
  options_json         String?   @db.NVarChar(Max)
  default_value        String?   @db.NVarChar(500)
  required             Boolean   @default(false)
  sort_order           Int       @default(0)
  savedView            SavedView @relation(fields: [id_saved_view], references: [id_saved_view], onDelete: Cascade)

  @@map("saved_view_filter")
  @@schema("dbo")
}

model SavedViewColumn {
  id_saved_view_column Int       @id @default(autoincrement())
  id_saved_view        Int
  column_key           String    @db.NVarChar(128)
  label                String    @db.NVarChar(150)
  data_type            String?   @db.NVarChar(30)
  sort_order           Int       @default(0)
  savedView            SavedView @relation(fields: [id_saved_view], references: [id_saved_view], onDelete: Cascade)

  @@map("saved_view_column")
  @@schema("dbo")
}

model CatalogSource {
  id_catalog_source Int            @id @default(autoincrement())
  id_process        Int?
  object_name       String         @db.NVarChar(128)
  object_type       String         @default("table") @db.NVarChar(20)
  label             String         @db.NVarChar(150)
  description       String?        @db.NVarChar(500)
  company_column    String?        @db.NVarChar(128)
  icon              String?        @db.NVarChar(60)
  sort_order        Int            @default(0)
  is_active         Boolean        @default(true)
  fields            CatalogField[]

  @@unique([object_name])
  @@map("catalog_source")
  @@schema("dbo")
}

model CatalogField {
  id_catalog_field  Int           @id @default(autoincrement())
  id_catalog_source Int
  column_name       String        @db.NVarChar(128)
  label             String        @db.NVarChar(150)
  data_type         String?       @db.NVarChar(30)
  is_pii            Boolean       @default(false)
  is_active         Boolean       @default(true)
  sort_order        Int           @default(0)
  source            CatalogSource @relation(fields: [id_catalog_source], references: [id_catalog_source], onDelete: Cascade)

  @@map("catalog_field")
  @@schema("dbo")
}

// ===================================================================
// Métricas diarias del SAP Business One Service Layer (OLP) — 2026-09-03.
// Reemplaza el Excel manual que se venía sacando a mano: cuenta líneas del
// log del balanceador del Service Layer (puerto 50000, recibe todo el
// tráfico, no hace falta sumar los nodos 50001-50010) en serfarma07
// (192.168.10.7) y las deja acá vía:
//   - Backfill histórico: prisma/seeds/run-service-layer-metrics-backfill.mjs
//   - Job diario: Tarea Programada de Windows en pce0023 (no en serfarma07,
//     ver lib/service-layer-metrics/collectDailyMetric.ts) que hace SSH
//     puntual a serfarma07 para contar el log del día ya cerrado y hace
//     upsert acá.
//
// `company` es texto libre (SIN FK a la tabla `company`) a propósito: hoy
// solo se llena "OLP", pero la idea es poder sumar otras empresas más
// adelante sin tener que resolver primero su id_company real (referencia
// blanda, sin relation()).
// ===================================================================
model ServiceLayerDailyMetric {
  id                Int      @id @default(autoincrement())
  company           String   @db.NVarChar(50)
  metric_date       DateTime @db.Date
  transaction_count Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([company, metric_date])
  @@map("service_layer_daily_metrics")
  @@schema("dbo")
}

// ===================================================================
// Módulo "Asistentes IA" — chat de agentes en SynerLink (Fase 2a: modelo de
// datos y permisos). 2026-09-06.
//
// AISLAMIENTO: este módulo no comparte ni modifica tablas de otros módulos;
// lo único común son las tablas de plataforma que ya existían (`user`, `company`, y el esquema de
// permisos process -> subprocess -> subprocess_user_company).
//
// -------------------------------------------------------------------
// DECISIÓN DE DISEÑO — dónde vive el PERMISO (una sola fuente de verdad)
// -------------------------------------------------------------------
// El diseño original contemplaba una tabla `user_agent_access`
// (usuario -> agente, con granted_by/granted_at). NO se creó, a propósito.
//
// El permiso es el SUBPROCESO. SynerLink ya modela "qué puede hacer un
// usuario" como una URL en `subprocess`, otorgada por la tripleta
// (usuario, empresa, subproceso) vía subprocess_user_company -> company_user,
// y esa tripleta ya se administra desde /process/administration/users.
// Nicolás pidió explícitamente que este módulo se asigne desde esa misma
// pantalla, "como cualquier otro módulo".
//
// Razones para NO duplicarlo en `user_agent_access`:
//   1. `user_agent_access` no tiene empresa. El permiso de SynerLink SÍ es
//      por empresa; una tabla usuario->agente plana no puede expresar
//      "Nicolás habla con Orus en GSS pero no en Ryan", y al mezclarse con
//      el subproceso quedarían dos respuestas distintas a la misma pregunta.
//   2. La auditoría que justificaba la tabla (quién otorgó y cuándo) ya
//      existe: app/api/users/[id]/subprocesses/route.ts escribe en
//      `user_audit_log` la acción UPDATE_SUBPROCESSES con performed_by y
//      created_at cada vez que se cambia una asignación.
//   3. Dos fuentes de verdad del mismo permiso es un riesgo de seguridad,
//      no una redundancia inofensiva: basta con que un endpoint consulte la
//      "equivocada" para abrir un hueco.
//
// El vínculo agente <-> subproceso es una FK REAL: `agent.id_subprocess`.
//   /process/chat        -> subproceso de acceso al módulo (CHAT_MODULE_URL)
//   /process/chat/orus   -> subproceso-permiso del agente Orus
// Se prefirió la FK a derivar la URL por convención (p.ej. '/process/chat/' +
// code) porque `code` y `display_name` no coinciden ('horus' vs. 'Orus') y
// una URL derivada de `display_name` se rompería en silencio el día que
// alguien renombre el agente — inaceptable tratándose de un permiso. Con la
// FK, renombrar el agente no mueve su permiso, y un subproceso no puede ser
// el permiso de dos agentes (índice único filtrado UX_agent_id_subprocess).
// Hay precedente de subprocesos que son solo marcadores de permiso y no
// páginas reales.
//
// `agent_company` es OTRA cosa: es la AGRUPACIÓN (las "carpetas" de la
// interfaz), no el permiso. Dice a qué empresas pertenece un agente —
// modelo N:N elegido por Nicolás (opción A) porque los agentes de GSS son
// transversales al grupo. Ver también lib/chat/access.ts: un usuario ve un
// agente en una empresa solo si (a) el agente pertenece a esa empresa y
// (b) el usuario tiene el subproceso del agente en esa misma empresa.
//
// Siembra: prisma/seeds/chat-agents.sql (idempotente, APPEND-ONLY). Siembra
// por NOMBRE de empresa, nunca por id: los id_company NO coinciden entre
// producción y KRONOSDB_PRUEBAS.
// ===================================================================

/// Catálogo de agentes (bots) de la flota. `code` es el identificador
/// estable ('horus'); `display_name` es como se ve en la interfaz ('Orus');
/// `handle` es el puente con Telegram ('@horus_gss_bot').
model Agent {
  id_agent          Int       @id @default(autoincrement())
  code              String    @db.NVarChar(60)
  display_name      String    @db.NVarChar(120)
  handle            String?   @db.NVarChar(60)
  /// Ruta relativa dentro de /public (p.ej. /agents/orus.png). NULL = la
  /// interfaz cae al avatar por inicial. A propósito no se guardan URLs
  /// externas: las fotos de usuario que hoy apuntan a postimg.cc son frágiles.
  avatar_url        String?   @db.NVarChar(500)
  /// Avatar SUBIDO desde la interfaz, guardado aquí y no en /public: Next
  /// resuelve esa carpeta con una lista de tiempo de compilación, así que un
  /// archivo nuevo daría 404 hasta el siguiente despliegue. Lo sirve
  /// GET /api/chat/agents/<code>/avatar. NULL = no le han subido ninguna y la
  /// interfaz sigue con `avatar_url` o con la inicial.
  avatar_blob       Bytes?    @db.VarBinary(Max)
  avatar_mime       String?   @db.NVarChar(100)
  /// Cuándo se subió. Sirve para saber si hay imagen sin traerse los bytes, y
  /// como número de versión en la URL (?v=…) para poder cachearla fuerte y que
  /// igual cambie al instante cuando la reemplacen.
  avatar_updated_at DateTime?
  description       String?   @db.NVarChar(500)
  is_active         Boolean   @default(true)
  sort_order        Int       @default(0)
  /// Subproceso que ES el permiso para hablar con este agente (fuente de
  /// verdad única del permiso; ver la nota de módulo arriba). NULL = agente
  /// del catálogo todavía sin subproceso creado, y por tanto invisible para
  /// todos. La unicidad se garantiza con un índice ÚNICO FILTRADO
  /// (WHERE id_subprocess IS NOT NULL) creado en la migración; no se declara
  /// @unique aquí porque SQL Server solo admite un NULL en un índice único
  /// no filtrado (mismo caso que User.nit).
  id_subprocess     Int?
  created_at        DateTime  @default(now())

  subprocess       Subprocess?           @relation(fields: [id_subprocess], references: [id_subprocess], onDelete: NoAction, onUpdate: NoAction)
  companies        AgentCompany[]
  conversations    ChatConversation[]
  participations   ChatParticipant[]
  messagesAuthored ChatMessage[]         @relation("ChatMessageAgentAuthor")
  deliveries       ChatMessageDelivery[]
  statuses         ChatAgentStatus[]
  turnUsage        ChatAgentTurnUsage[]

  @@unique([code])
  @@map("agent")
  @@schema("dbo")
}

/// Agrupación agente <-> empresa (las "carpetas" de la interfaz). NO es el
/// permiso: ver la nota de módulo arriba. `is_primary` marca la empresa
/// principal del agente (los de GSS son transversales al grupo).
model AgentCompany {
  id_agent_company Int     @id @default(autoincrement())
  id_agent         Int
  id_company       Int
  is_primary       Boolean @default(false)

  agent   Agent   @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)
  company Company @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_agent, id_company])
  @@index([id_company])
  @@map("agent_company")
  @@schema("dbo")
}

/// Hilo de conversación. Hay DOS clases, distinguidas por `kind`:
///
///   'direct' — UNA persona con UN agente. Es el hilo original y el que usa
///              toda la flota. La propiedad es `id_user`: todo endpoint debe
///              verificar que el id_conversation que llega del cliente
///              pertenece al usuario de la sesión (IDOR).
///   'group'  — VARIAS personas y VARIOS agentes. La pertenencia NO se lee de
///              `id_user`/`id_agent` sino de `ChatParticipant`.
///
/// ⚠️ EN UN GRUPO, `id_user` y `id_agent` SON METADATOS, NO PERMISO.
/// Lo natural sería dejarlos en NULL, pero las dos columnas están dentro de
/// índices y SQL Server rechaza un ALTER COLUMN sobre una columna indexada:
/// volverlas nullables obligaba a tumbar índices y claves ajenas de una tabla
/// viva. Se decidió no pagar ese riesgo (ver el encabezado de la migración
/// 20260908180000_add_chat_groups). En un grupo:
///   - `id_user`  = quien lo creó (además queda como participante 'owner').
///   - `id_agent` = el agente ANFITRIÓN, la cara del grupo en la bandeja.
/// Quien pregunte "¿este usuario puede entrar?" tiene que consultar
/// ChatParticipant, nunca estas dos columnas.
model ChatConversation {
  id              Int       @id @default(autoincrement())
  id_user         String    @db.NVarChar(1000)
  id_agent        Int
  title           String?   @db.NVarChar(300)
  /// 'direct' | 'group' | 'people'. Texto y no enum porque el provider
  /// sqlserver de Prisma no soporta enums nativos. Hay un CHECK en la base
  /// que solo admite esos valores. 'people' = hilo privado entre DOS personas,
  /// sin agentes (lib/chat/people-rules.ts).
  kind            String    @default("direct") @db.NVarChar(20)
  /// Solo en 'people': clave única del PAR de personas (lib/chat/people-rules.ts,
  /// buildDmKey). Un índice ÚNICO FILTRADO (WHERE dm_key IS NOT NULL) impide
  /// dos hilos para el mismo par; no se declara @unique aquí por el mismo
  /// motivo que User.nit (SQL Server solo admite un NULL en un único normal).
  dm_key          String?   @db.NVarChar(120)
  /// Empresa del grupo. NULL en los hilos directos: allí la empresa la define
  /// el permiso sobre el agente, no el hilo.
  id_company      Int?
  /// Quién creó el grupo. Redundante con `id_user` hoy, pero explícito a
  /// propósito: `id_user` se lee como "el dueño" y en un grupo eso no
  /// significa lo mismo.
  created_by      String?   @db.NVarChar(1000)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  /// Denormalizado para ordenar la bandeja sin agregar sobre chat_message.
  last_message_at DateTime?
  archived        Boolean   @default(false)

  user         User                 @relation("ChatConversationUser", fields: [id_user], references: [id], onDelete: Cascade)
  agent        Agent                @relation(fields: [id_agent], references: [id_agent], onDelete: NoAction, onUpdate: NoAction)
  company      Company?             @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  creator      User?                @relation("ChatConversationCreator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages     ChatMessage[]
  participants ChatParticipant[]
  /// Un indicador POR AGENTE: en un grupo hay varios trabajando a la vez.
  statuses     ChatAgentStatus[]
  turnUsage    ChatAgentTurnUsage[]

  @@index([id_user, archived, last_message_at(sort: Desc)])
  @@index([id_agent])
  @@index([kind, archived, last_message_at(sort: Desc)])
  @@map("chat_conversation")
  @@schema("dbo")
}

/// Chats ANCLADOS de la barra lateral del chat (2026-09-30). Una fila por
/// persona y por chat anclado; es SU preferencia y nadie más la ve.
///
/// `target_key` dice QUÉ se ancló, con el mismo formato que usa la interfaz
/// (lib/chat/rail.ts): 'agent:<id_agent>' para un asistente —se puede anclar
/// aunque todavía no exista la conversación— y 'conv:<id>' para un grupo o un
/// hilo entre personas. Texto y no dos llaves foráneas a propósito: un ancla
/// que apunta a algo que ya no se ve simplemente no se pinta.
///
/// Tabla NUEVA y aparte: si el código sale antes que el DDL solo fallan las
/// anclas (la ruta responde "sin anclas"), no el chat entero.
model ChatPin {
  id         Int      @id @default(autoincrement())
  id_user    String   @db.NVarChar(1000)
  target_key String   @db.NVarChar(60)
  created_at DateTime @default(now())

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@unique([id_user, target_key], map: "chat_pin_user_target_key")
  @@map("chat_pin")
  @@schema("dbo")
}

/// Integrante de un grupo: una PERSONA o un AGENTE, nunca los dos.
/// Es la ÚNICA fuente de verdad de quién está en un grupo — un CHECK en la
/// base garantiza que exactamente una de las dos columnas venga con valor,
/// para que no dependa de que cada endpoint se acuerde de validarlo.
model ChatParticipant {
  id_participant       Int      @id @default(autoincrement())
  id_conversation      Int
  id_user              String?  @db.NVarChar(1000)
  id_agent             Int?
  /// 'owner' = puede agregar y quitar integrantes. 'member' = solo participa.
  role                 String   @default("member") @db.NVarChar(20)
  /// Id del último mensaje que esta persona ya vio. Es la marca de agua con la
  /// que se cuentan sus no leídos: `chat_message.read_at` no sirve en un grupo
  /// porque es una sola columna por mensaje y el primero que leyera lo daría
  /// por leído para todos los demás. NULL = nunca ha abierto el grupo.
  last_read_message_id Int?
  added_at             DateTime @default(now())
  /// Último zumbido que ESTA persona envió en este hilo. El límite de "uno cada
  /// 30 s" es un UPDATE atómico sobre esta columna (lib/chat/nudge.ts): vale
  /// igual con las dos instancias de producción, sin estado en memoria.
  last_nudge_at        DateTime?
  /// Esta persona silenció los zumbidos de ESTE hilo. El remitente no se
  /// entera (decisión D5): su zumbido queda escrito, solo que aquí no suena,
  /// no sacude y no manda push.
  nudges_muted         Boolean  @default(false)

  conversation ChatConversation @relation(fields: [id_conversation], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [id_user], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent        Agent?           @relation(fields: [id_agent], references: [id_agent], onDelete: NoAction, onUpdate: NoAction)

  /// Los dos únicos son ÍNDICES FILTRADOS en la base (WHERE ... IS NOT NULL),
  /// porque la mitad de las filas tiene una de las dos columnas en NULL a
  /// propósito y SQL Server solo admite un NULL en un único no filtrado. No
  /// se declaran con @@unique aquí por el mismo motivo que User.nit.
  @@index([id_user])
  @@index([id_agent])
  @@map("chat_participant")
  @@schema("dbo")
}

/// Un mensaje del hilo.
/// Anuncios del PORTAL DE TALENTO HUMANO, cargados desde el propio portal.
///
/// En la base y no en SharePoint: el conector que lee ese sitio es de SOLO
/// LECTURA a propósito, y darle escritura significaría poder escribir en todo
/// el tenant con una credencial que ya tiene de más. Para subir un anuncio no
/// vale la pena abrir esa puerta.
model PortalBanner {
  id          Int      @id @default(autoincrement())
  file_name   String   @db.NVarChar(255)
  mime        String   @db.NVarChar(100)
  contenido   Bytes    @db.VarBinary(Max)
  /// Para ordenarlos a mano más adelante sin migrar otra vez.
  orden       Int      @default(0)
  /// Quién lo subió: si aparece un anuncio que nadie reconoce, hay que poder
  /// saber de dónde salió.
  uploaded_by String   @db.NVarChar(255)
  created_at  DateTime @default(now())

  @@index([orden, id(sort: Desc)])
  @@map("portal_banner")
  @@schema("dbo")
}

/// Códigos de un solo uso del PORTAL DE TALENTO HUMANO.
///
/// El portal no usa la sesión de SynerLink: entra cualquier colaborador con
/// correo de una empresa del grupo (o de la lista de excepciones), y la
/// identidad se comprueba con un código enviado a ese correo.
///
/// Vive en la base y no en memoria porque producción corre en clúster de dos
/// instancias: un código emitido por una y verificado por la otra fallaría de
/// forma intermitente.
model PortalAccessCode {
  id         Int       @id @default(autoincrement())
  /// Siempre en minúsculas: es como se consulta.
  email      String    @db.NVarChar(255)
  /// SHA-256 del código. NUNCA el código en claro: quien lea la tabla —o un
  /// respaldo— no puede entrar con lo que ve.
  code_hash  String    @db.NVarChar(64)
  created_at DateTime  @default(now())
  expires_at DateTime
  /// Marca de uso: un código sirve UNA vez.
  used_at    DateTime?
  /// Intentos fallidos. Seis dígitos sin tope se prueban en minutos.
  attempts   Int       @default(0)

  @@index([email, id(sort: Desc)])
  @@index([expires_at])
  @@map("portal_access_code")
  @@schema("dbo")
}

/// ══════════════════ PORTAL DE TALENTO HUMANO — FORMACIÓN ═══════════════════
/// Pedido de Cristian Baldión (2026-09-18): una sección "tipo Moodle" al
/// final del portal — cursos con materiales (documento o enlace), una barra
/// de progreso que ve el formador Y el estudiante, y un certificado al llegar
/// al 100%.
///
/// La identidad sigue siendo un CORREO, nunca un FK a `User`: el portal lo
/// usa gente sin usuario en SynerLink (ver `lib/portal/acceso.ts`). Por eso
/// tanto el formador (`created_by`) como el estudiante (`student_email`) se
/// guardan como texto, igual que `uploaded_by` en `portal_banner`.
///
/// Un curso "publicado" (`active = true`) es visible para cualquier persona
/// identificada en el portal, que se autoinscribe al abrirlo — no hay
/// aprobación de un formador para entrar, a propósito: es lo más simple que
/// no bloquea a nadie. Si más adelante Talento Humano pide inscripción con
/// aprobación, es un campo de estado nuevo en `PortalCourseEnrollment`, no un
/// cambio de estas tablas.

/// Un curso.
model PortalCourse {
  id          Int      @id @default(autoincrement())
  title       String   @db.NVarChar(255)
  description String?  @db.NVarChar(Max)
  active      Boolean  @default(true)
  /// Correo de quien lo creó (el formador).
  created_by  String   @db.NVarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  /// Carpeta del curso dentro de FORMACION en SharePoint (`<slug>-<id>`).
  /// Se fija en la primera subida y no cambia si el curso se renombra.
  sp_folder_name String? @db.NVarChar(200)

  materials    PortalCourseMaterial[]
  enrollments  PortalCourseEnrollment[]
  certificates PortalCertificate[]

  @@index([active, id(sort: Desc)])
  @@map("portal_course")
  @@schema("dbo")
}

/// Un material del curso: un documento cargado (bytes en la base, igual que
/// `portal_banner.contenido` — se reutiliza el mismo mecanismo en vez de
/// inventar uno nuevo, ver `app/api/portal/courses/[id]/materials/route.ts`)
/// o un enlace externo (cuestionario de Google/Microsoft Forms, video,
/// cualquier URL).
model PortalCourseMaterial {
  id        Int          @id @default(autoincrement())
  course_id Int
  course    PortalCourse @relation(fields: [course_id], references: [id], onDelete: Cascade)
  /// 'DOCUMENT' | 'LINK'. Texto y no enum: el provider sqlserver no los
  /// soporta (mismo criterio que el resto de este esquema).
  type      String       @db.NVarChar(20)
  title     String       @db.NVarChar(255)
  /// Para mostrar los materiales en el orden que definió el formador.
  orden     Int          @default(0)
  /// Solo si type = 'LINK'.
  url       String?      @db.NVarChar(1000)
  /// Solo si type = 'DOCUMENT'. El archivo vive en SharePoint
  /// (TalentoHumano/FORMACION/<curso>/materiales) — aquí solo la referencia.
  file_name String?      @db.NVarChar(255)
  mime      String?      @db.NVarChar(100)
  sp_drive_item_id String? @db.NVarChar(200)
  sp_web_url       String? @db.NVarChar(1000)
  file_size        BigInt?
  /// Quitado del curso por el formador (borrado LÓGICO): el archivo se movió
  /// a FORMACION/ELIMINADOS/<curso>/materiales en SharePoint. Pedido de
  /// Cristian (2026-09-30): nada se borra de SharePoint.
  eliminado_at     DateTime?
  eliminado_por    String? @db.NVarChar(255)
  /// EN DESUSO desde 2026-09-30 (migración 20260930120000): ya no se escribe.
  /// Solo se lee para servir materiales subidos antes del cambio a
  /// SharePoint. Pendiente de retiro en un PR posterior.
  contenido Bytes?       @db.VarBinary(Max)
  /// Si hace falta marcarlo como completado para que el curso llegue a 100%.
  required  Boolean      @default(true)
  created_at DateTime    @default(now())

  progress PortalMaterialProgress[]

  @@index([course_id, orden])
  @@map("portal_course_material")
  @@schema("dbo")
}

/// Quién está inscrito en qué curso. Autoinscripción al abrir un curso
/// publicado — ver nota arriba.
model PortalCourseEnrollment {
  id             Int          @id @default(autoincrement())
  course_id      Int
  course         PortalCourse @relation(fields: [course_id], references: [id], onDelete: Cascade)
  student_email  String       @db.NVarChar(255)
  enrolled_at    DateTime     @default(now())

  @@unique([course_id, student_email])
  @@map("portal_course_enrollment")
  @@schema("dbo")
}

/// Progreso de UN estudiante en UN material. El % del curso se calcula
/// contando filas de esta tabla contra el total de materiales — no se guarda
/// un porcentaje aparte para no tener dos fuentes de verdad que se puedan
/// desincronizar.
model PortalMaterialProgress {
  id             Int                  @id @default(autoincrement())
  material_id    Int
  material       PortalCourseMaterial @relation(fields: [material_id], references: [id], onDelete: Cascade)
  student_email  String               @db.NVarChar(255)
  completed_at   DateTime             @default(now())

  @@unique([material_id, student_email])
  @@index([student_email])
  @@map("portal_material_progress")
  @@schema("dbo")
}

/// Certificado emitido al llegar al 100% de un curso. `course_title` y
/// `student_name` quedan CONGELADOS al momento de emitir: si el curso cambia
/// de nombre después, el certificado ya entregado no debe cambiar con él.
/// `code` es lo que valida `GET /api/portal/certificates/[code]` — sirve para
/// reimprimir el mismo PDF sin regenerarlo con datos distintos.
model PortalCertificate {
  id            Int          @id @default(autoincrement())
  code          String       @unique @db.NVarChar(40)
  course_id     Int
  course        PortalCourse @relation(fields: [course_id], references: [id])
  student_email String       @db.NVarChar(255)
  student_name  String       @db.NVarChar(255)
  course_title  String       @db.NVarChar(255)
  issued_at     DateTime     @default(now())
  /// PDF archivado en SharePoint (TalentoHumano/FORMACION/<curso>/certificados).
  sp_drive_item_id String? @db.NVarChar(200)
  sp_web_url       String? @db.NVarChar(1000)
  file_name        String? @db.NVarChar(255)
  file_size        BigInt?

  @@unique([course_id, student_email])
  @@index([student_email])
  @@map("portal_certificate")
  @@schema("dbo")
}

model ChatMessage {
  id              Int    @id @default(autoincrement())
  id_conversation Int
  /// 'user' | 'agent' | 'system'. Texto y no enum porque el provider
  /// sqlserver de Prisma no soporta enums nativos.
  role            String @db.NVarChar(20)
  /// MARKDOWN CRUDO. NUNCA HTML: el HTML se guarda tal cual y se renderiza
  /// en el cliente, así que almacenarlo abriría un XSS almacenado. El
  /// render a HTML es responsabilidad de la interfaz, sanitizando.
  body            String @db.NVarChar(Max)

  /// Autor PERSONA. En un hilo directo es siempre el dueño y se puede deducir
  /// de la conversación; en un grupo es imprescindible saber cuál de las
  /// personas escribió. NULL en los mensajes del agente y en los de sistema.
  id_user_author  String? @db.NVarChar(1000)
  /// Autor AGENTE. NULL en los mensajes de personas y en los de sistema.
  id_agent_author Int?

  /// Marca de EVENTO de un mensaje de sistema. NULL = mensaje normal (la
  /// enorme mayoría). 'nudge' = zumbido entre personas (lib/chat/nudge.ts):
  /// queda en el hilo y en la auditoría como cualquier mensaje, y el límite
  /// anti-abuso se cuenta sobre estas filas (índice filtrado
  /// chat_message_nudge_idx). CHECK en la base: solo NULL o 'nudge'.
  event_type      String? @db.NVarChar(20)

  /// El mensaje AL QUE RESPONDE, cuando se citó uno. NULL = mensaje normal,
  /// que es la enorme mayoría. Normalizado y no con el texto copiado: el id
  /// hace falta igual para poder SALTAR al original, y así una corrección del
  /// original no deja la cita diciendo lo viejo.
  id_reply_to Int?

  created_at DateTime @default(now())

  /// ORIGEN DE LA CONEXIÓN de quien escribió — auditoría (pedido de Nicolás
  /// el 2026-09-10: "la ip de dónde enviaron el mensaje y la hora").
  ///
  /// Se llenan SOLO en los mensajes de personas: en los del agente no hay
  /// navegador ni IP de cliente, el mensaje entra por la API con su llave.
  ///
  /// Sale de la petición HTTP, nunca del payload: `x-forwarded-for` que pone
  /// el proxy de IIS (ARR) delante de la aplicación. Queda NULL cuando la
  /// cabecera no llega, que es lo honesto — una IP inventada es peor que no
  /// tener el dato. Ver lib/chat/client-origin.ts.
  client_ip  String? @db.NVarChar(64)
  /// Navegador declarado por el cliente. Es un dato que el cliente controla y
  /// puede mentir; sirve para distinguir un celular de un equipo de escritorio
  /// en una revisión, no como prueba.
  user_agent String? @db.NVarChar(400)

  /// Momento en que el agente confirmó la recepción (puente con Telegram).
  /// SOLO SIRVE EN HILOS DIRECTOS, donde hay un único agente. En un grupo la
  /// entrega se lleva en ChatMessageDelivery, una fila por agente: si se usara
  /// esta columna, el primer agente que recogiera el mensaje lo marcaría
  /// entregado y los demás no lo verían nunca.
  delivered_at DateTime?
  read_at      DateTime?

  conversation ChatConversation      @relation(fields: [id_conversation], references: [id], onDelete: Cascade)
  /// NO ACTION y no Cascade: es una FK a la MISMA tabla y ya existe un camino
  /// de borrado en cascada (id_conversation), que SQL Server rechaza combinar.
  /// Hoy nada borra mensajes; si algún día se agrega, esto falla ruidosamente
  /// en vez de dejar citas apuntando al vacío.
  replyTo      ChatMessage?          @relation("ChatMessageReplyTo", fields: [id_reply_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      ChatMessage[]         @relation("ChatMessageReplyTo")
  attachments  ChatAttachment[]
  userAuthor   User?                 @relation("ChatMessageUserAuthor", fields: [id_user_author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentAuthor  Agent?                @relation("ChatMessageAgentAuthor", fields: [id_agent_author], references: [id_agent], onDelete: NoAction, onUpdate: NoAction)
  deliveries   ChatMessageDelivery[]
  voiceEvent   ChatVoiceEvent?

  @@index([id_conversation, id(sort: Desc)])
  @@index([id_conversation, created_at])
  @@index([id_agent_author])
  @@index([id_reply_to])
  @@map("chat_message")
  @@schema("dbo")
}

/// Entrega de UN mensaje de grupo a UN agente — y, a la vez, el registro de
/// que ese agente fue MENCIONADO en ese mensaje.
///
/// Las dos cosas son el mismo hecho a propósito: **existe una fila solo si el
/// agente fue mencionado**, y `delivered_at` dice si ya lo recogió. Así "a
/// quién le toca" y "quién ya lo tiene" no pueden contradecirse, y la bandeja
/// del agente es una lectura directa por índice
/// (id_agent, delivered_at, id_message).
///
/// Lo que la interfaz resalta en el texto NO se lee de aquí: se resuelve
/// leyendo el propio cuerpo del mensaje, para que el render nunca dependa del
/// estado de entrega.
model ChatMessageDelivery {
  id_message   Int
  id_agent     Int
  /// NULL = pendiente, es lo que devuelve el long-poll de la bandeja.
  delivered_at DateTime?

  message ChatMessage @relation(fields: [id_message], references: [id], onDelete: Cascade)
  agent   Agent       @relation(fields: [id_agent], references: [id_agent], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_message, id_agent])
  @@index([id_agent, delivered_at, id_message])
  @@map("chat_message_delivery")
  @@schema("dbo")
}

/// Adjunto de un mensaje. El archivo vive en OneDrive; aquí solo queda la
/// referencia.
model ChatAttachment {
  id               Int      @id @default(autoincrement())
  id_message       Int
  file_name        String   @db.NVarChar(400)
  content_type     String?  @db.NVarChar(200)
  size_bytes       Int?
  onedrive_item_id String?  @db.NVarChar(300)
  web_url          String?  @db.NVarChar(1000)
  created_at       DateTime @default(now())

  message ChatMessage @relation(fields: [id_message], references: [id], onDelete: Cascade)

  @@index([id_message])
  @@map("chat_attachment")
  @@schema("dbo")
}

/// CONSUMO EN TOKENS de un turno de un agente — auditoría.
///
/// POR QUÉ EXISTE (pedido de Nicolás el 2026-09-10, auditoría de permisos):
/// las conversaciones ya quedan registradas en `chat_message`, pero el COSTO de
/// atenderlas no queda en ninguna parte. Sin esto no hay forma de revisar si un
/// agente se está usando para algo desproporcionado.
///
/// POR QUÉ LO REPORTA EL CONECTOR Y NO LA APLICACIÓN: los tokens los informa la
/// API del modelo al proceso del agente (Claude Code), que los escribe en la
/// bitácora de su sesión. La aplicación NUNCA los ve. Por eso cada agente los
/// manda por POST /api/chat/agent/usage al cerrar el turno, con su propia
/// llave — y el `id_agent` sale de la llave, no del payload.
///
/// UNA FILA POR TURNO Y POR CONVERSACIÓN: si un turno atendió a dos
/// conversaciones a la vez, el agente reporta el mismo consumo para cada una,
/// porque no hay manera de partir el gasto de un turno compartido. Al sumar por
/// conversación eso se debe tener presente; `session_id` + `turn_started_at`
/// permiten reconocer las filas que son el mismo turno.
model ChatAgentTurnUsage {
  id              Int @id @default(autoincrement())
  id_conversation Int
  id_agent        Int

  /// Sesión del proceso del agente. Junto con turn_started_at identifica el
  /// turno, y permite reconocer un mismo turno repartido en varias filas.
  session_id             String? @db.NVarChar(120)
  /// Modelos que atendieron el turno, separados por coma (p. ej. 'claude-opus-5').
  models                 String? @db.NVarChar(300)
  /// Llamados a la API que hizo el turno (no mensajes del chat: un turno
  /// publica una respuesta pero puede hacer decenas de llamados).
  api_messages           Int     @default(0)
  /// De esos llamados, los que hicieron los sub-agentes.
  api_messages_subagents Int     @default(0)

  /// Renglones del consumo. Se guardan separados y no solo el total porque no
  /// cuestan lo mismo: la lectura de caché es una fracción del precio de la
  /// entrada normal, y un total único no permite revisar nada.
  input_tokens          Int @default(0)
  cache_creation_tokens Int @default(0)
  cache_read_tokens     Int @default(0)
  output_tokens         Int @default(0)
  /// Parte de la salida que fue razonamiento. YA ESTÁ DENTRO de output_tokens;
  /// se guarda aparte para poder mirarlo, no para sumarlo otra vez.
  thinking_tokens       Int @default(0)
  /// entrada + creación de caché + lectura de caché + salida. Redundante a
  /// propósito: es la cifra por la que se ordena y se filtra el tablero, y
  /// calcularla en cada consulta obliga a leer toda la tabla.
  total_tokens          Int @default(0)

  /// Ventana del turno según la bitácora del agente. NULL si no se pudo
  /// determinar.
  turn_started_at DateTime?
  turn_ended_at   DateTime?
  /// Momento en que se recibió el reporte.
  created_at      DateTime  @default(now())

  conversation ChatConversation @relation(fields: [id_conversation], references: [id], onDelete: Cascade)
  agent        Agent            @relation(fields: [id_agent], references: [id_agent], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_conversation, created_at])
  @@index([id_agent, created_at])
  @@index([created_at])
  @@map("chat_agent_turn_usage")
  @@schema("dbo")
}

/// Estado en vivo del agente dentro de una conversación — alimenta el
/// indicador de "qué está haciendo" (pensando / usando una herramienta).
/// Una sola fila por conversación Y AGENTE (la PK es (id_conversation,
/// id_agent)): es un estado puntual que se sobrescribe, no un histórico.
model ChatAgentStatus {
  id_conversation Int
  /// El agente al que corresponde este indicador. En un hilo directo es el
  /// agente del hilo; en un grupo, cada agente tiene el suyo. Forma parte de
  /// la clave primaria: antes la clave era solo `id_conversation` y en un
  /// grupo no cabía más que un indicador.
  id_agent        Int
  /// 'idle' | 'thinking' | 'tool'.
  state           String   @default("idle") @db.NVarChar(20)
  /// Texto libre que se muestra al usuario ("Consultando SAP…").
  label           String?  @db.NVarChar(200)
  /// Sub-agentes en curso, serializados como JSON:
  /// [{"desc":"Muestra de phishing","startedAt":"2026-09-07T13:20:00.000Z"}]
  /// NULL o [] = sin desglose, y la interfaz cae al `label` de siempre. Se
  /// guarda como TEXTO porque SQL Server no tiene tipo JSON nativo aquí, y
  /// nunca se consulta por contenido: es solo para pintar la tablita de "qué
  /// está corriendo". Por eso tampoco lleva índice.
  tasks           String?  @db.NVarChar(Max)
  updated_at      DateTime @updatedAt

  conversation ChatConversation @relation(fields: [id_conversation], references: [id], onDelete: Cascade)
  agent        Agent            @relation(fields: [id_agent], references: [id_agent], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_conversation, id_agent])
  @@map("chat_agent_status")
  @@schema("dbo")
}

/// Server-owned identity of a voice call; retained for delayed audit retries.
model ChatVoiceCall {
  id              String           @id @db.VarChar(36)
  id_conversation Int
  id_agent        Int
  id_user         String           @db.NVarChar(1000)
  client_ip       String?          @db.NVarChar(64)
  user_agent      String?          @db.NVarChar(400)
  created_at      DateTime         @default(now())
  expires_at      DateTime
  offer_sdp       String   @db.NVarChar(Max)
  answer_sdp      String?  @db.NVarChar(Max)
  error           String?  @db.NVarChar(400)
  claimed         Boolean  @default(false)
  events          ChatVoiceEvent[]

  @@index([id_conversation])
  @@map("chat_voice_call")
  @@schema("dbo")
}

/// Durable receipt: retries of one Gateway event cannot create extra messages.
model ChatVoiceEvent {
  event_key  String        @id @db.VarChar(64)
  call_id    String        @db.VarChar(36)
  id_message Int           @unique
  call       ChatVoiceCall @relation(fields: [call_id], references: [id], onDelete: Cascade)
  message    ChatMessage   @relation(fields: [id_message], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("chat_voice_event")
  @@schema("dbo")
}

/// Historial y candado global de las corridas del módulo de Balances.
/// Vive en la base de SynerLink (KRONOSDB/KRONOSDB_PRUEBAS), no en la base SAP.
model BalanceRun {
  id                    Int       @id @default(autoincrement())
  id_company            Int
  triggered_by          String    @db.NVarChar(255)
  status                String    @db.NVarChar(20)
  started_at            DateTime  @default(now())
  finished_at           DateTime?
  balance_duration_ms   Int?
  acumulado_duration_ms Int?
  error_message         String?   @db.NVarChar(Max)

  @@index([id_company, id])
  @@index([status])
  @@map("balance_run")
  @@schema("dbo")
}

// ===================================================================
// SGC documental (Sistema de Gestión de Calidad) — Sprint 0, 2026-09-30.
// Plan: proyectos/sgc-olp-gestion-documental.md del vault de horus.
//
// AISLAMIENTO: todas las tablas del SGC viven en el esquema SQL `sgc`
// (no en `dbo`), para que ningún cambio de SynerLink general toque el
// módulo validado y viceversa. Lo único compartido son las tablas de
// plataforma (usuarios, empresas, permisos por subproceso).
//
// Multiempresa desde el diseño, activación por empresa: una empresa solo
// ve el SGC si tiene fila aquí con is_active = 1 (además del permiso por
// subproceso). Al inicio solo se activa One Latam Pharma (id_company = 3).
// Activar otra empresa es un cambio controlado: ver la skill
// sgc-activar-empresa.
// ===================================================================
model SgcCompanyConfig {
  id_company        Int      @id
  is_active         Boolean  @default(false)
  // Carpeta raíz propia de la empresa en OneDrive (p.ej. "SGC/OLP").
  storage_root      String   @db.NVarChar(300)
  // Quién activó/desactivó la empresa, cuándo y por qué (control de cambios).
  activated_by      String?  @db.NVarChar(255)
  activated_at      DateTime?
  change_reason     String?  @db.NVarChar(1000)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company Company @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)

  // Sprint 1: maestros y repositorio de la empresa.
  codingGuide   SgcCodingGuide?
  processTypes  SgcProcessType[]
  processes     SgcProcessMap[]
  documentTypes SgcDocumentType[]
  documents     SgcDocument[]

  // Sprint 2: motor de flujos validados, solicitudes y autorizaciones propias.
  flowProcesses      SgcFlowProcess[]
  responsibleMatrix  SgcResponsibleMatrix[]
  requests           SgcRequest[]
  authorizationTypes SgcAuthorizationType[]

  @@map("company_config")
  @@schema("sgc")
}

// ---------------------------------------------------------------------------
// SGC documental — Sprint 1: repositorio y listado maestro (esquema `sgc`).
// Todo cuelga de sgc.company_config (solo una empresa ACTIVADA tiene maestros).
// Nada se borra: los maestros se desactivan (is_active) y los documentos se
// anulan; cada cambio queda en sgc.audit_log (solo inserción).
// ---------------------------------------------------------------------------

// Guía de codificación de la empresa (una por empresa). El patrón admite las
// marcas {PREFIJO}, {TIPO_PROCESO}, {PROCESO}, {TIPO} y {CONSECUTIVO}
// (obligatoria); ver lib/sgc/coding.ts.
model SgcCodingGuide {
  id_company      Int      @id
  prefix          String   @db.NVarChar(10)
  pattern         String   @db.NVarChar(200)
  sequence_digits Int      @default(3)
  updated_by      String?  @db.NVarChar(255)
  change_reason   String?  @db.NVarChar(1000)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  companyConfig SgcCompanyConfig @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)

  @@map("coding_guide")
  @@schema("sgc")
}

// Tipo de proceso (estratégico, misional, soporte, funciones y responsabilidades…).
model SgcProcessType {
  id_process_type Int      @id @default(autoincrement())
  id_company      Int
  code            String   @db.NVarChar(10)
  name            String   @db.NVarChar(150)
  color           String   @default("blue") @db.NVarChar(20)
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  companyConfig SgcCompanyConfig @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  processes     SgcProcessMap[]

  @@unique([id_company, code])
  @@map("process_type")
  @@schema("sgc")
}

// Proceso del mapa de procesos (con su área/departamento dueño).
model SgcProcessMap {
  id_process_map  Int      @id @default(autoincrement())
  id_company      Int
  id_process_type Int
  code            String   @db.NVarChar(10)
  name            String   @db.NVarChar(200)
  id_department   Int?
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  companyConfig SgcCompanyConfig @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  processType   SgcProcessType   @relation(fields: [id_process_type], references: [id_process_type], onDelete: NoAction, onUpdate: NoAction)
  department    Department?      @relation(fields: [id_department], references: [id_department], onDelete: NoAction, onUpdate: NoAction)
  documents     SgcDocument[]
  // Sprint 2
  responsibles  SgcResponsibleMatrix[]
  requests      SgcRequest[]

  @@unique([id_company, code])
  @@map("process_map")
  @@schema("sgc")
}

// Tipo documental (manual, procedimiento, instructivo, formato…).
model SgcDocumentType {
  id_document_type  Int      @id @default(autoincrement())
  id_company        Int
  code              String   @db.NVarChar(10)
  name              String   @db.NVarChar(100)
  plural_name       String   @db.NVarChar(100)
  // Decisión de Nicolás (2026-09-30): la capacitación es obligatoria para todos los tipos.
  requires_training Boolean  @default(true)
  review_months     Int      @default(36)
  alert_months      Int      @default(2)
  sort_order        Int      @default(0)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  companyConfig SgcCompanyConfig @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  documents     SgcDocument[]
  // Sprint 2
  responsibles  SgcResponsibleMatrix[]
  requests      SgcRequest[]

  @@unique([id_company, code])
  @@map("document_type")
  @@schema("sgc")
}

// Documento controlado. current_version_id apunta a la versión VIGENTE (sin
// FK para no crear un ciclo documento↔versión; lo mantiene lib/sgc).
model SgcDocument {
  id_document         Int       @id @default(autoincrement())
  id_company          Int
  code                String    @db.NVarChar(60)
  title               String    @db.NVarChar(300)
  id_document_type    Int
  id_process_map      Int
  id_owner_department Int?
  // publica (toda la empresa) | departamento | confidencial
  confidentiality     String    @default("publica") @db.NVarChar(20)
  // borrador | vigente | obsoleto | anulado
  status              String    @default("borrador") @db.NVarChar(20)
  sequence_number     Int?
  current_version_id  Int?
  next_review_date    DateTime? @db.Date
  created_by          String    @db.NVarChar(255)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  annulled_by         String?   @db.NVarChar(255)
  annulled_at         DateTime?
  annul_reason        String?   @db.NVarChar(1000)

  companyConfig   SgcCompanyConfig    @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  documentType    SgcDocumentType     @relation(fields: [id_document_type], references: [id_document_type], onDelete: NoAction, onUpdate: NoAction)
  process         SgcProcessMap       @relation(fields: [id_process_map], references: [id_process_map], onDelete: NoAction, onUpdate: NoAction)
  ownerDepartment Department?         @relation(fields: [id_owner_department], references: [id_department], onDelete: NoAction, onUpdate: NoAction)
  versions        SgcDocumentVersion[]
  accesses        SgcDocumentAccess[]
  // Sprint 2: solicitudes documentales sobre el documento (nueva versión, modificación).
  requests        SgcRequest[]

  @@unique([id_company, code])
  @@index([id_company, status])
  @@map("document")
  @@schema("sgc")
}

// Versión de un documento: archivo PDF controlado (y fuente Word opcional) en
// la carpeta propia de la empresa, SGC/<EMPRESA>/<TIPO>/<CODIGO>/v<n>/.
model SgcDocumentVersion {
  id_document_version Int       @id @default(autoincrement())
  id_document         Int
  version_number      Int
  // borrador | vigente | obsoleto | anulado
  status              String    @db.NVarChar(20)
  pdf_item_id         String    @db.NVarChar(200)
  pdf_path            String    @db.NVarChar(600)
  pdf_file_name       String    @db.NVarChar(260)
  pdf_sha256          String    @db.Char(64)
  pdf_size            Int
  source_item_id      String?   @db.NVarChar(200)
  source_path         String?   @db.NVarChar(600)
  source_file_name    String?   @db.NVarChar(260)
  change_description  String?   @db.NVarChar(2000)
  effective_date      DateTime? @db.Date
  review_due_date     DateTime? @db.Date
  obsolete_date       DateTime? @db.Date
  created_by          String    @db.NVarChar(255)
  created_at          DateTime  @default(now())

  document SgcDocument @relation(fields: [id_document], references: [id_document], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_document, version_number])
  @@map("document_version")
  @@schema("sgc")
}

// Acceso a un documento por departamento o por persona. Consulta (can_view) y
// permisos EXCEPCIONALES de descarga/impresión, con vencimiento. No se borra:
// se revoca (revoked_at).
model SgcDocumentAccess {
  id_document_access Int       @id @default(autoincrement())
  id_document        Int
  id_department      Int?
  user_email         String?   @db.NVarChar(255)
  can_view           Boolean   @default(true)
  can_download       Boolean   @default(false)
  can_print          Boolean   @default(false)
  expires_at         DateTime?
  reason             String    @db.NVarChar(1000)
  granted_by         String    @db.NVarChar(255)
  created_at         DateTime  @default(now())
  revoked_at         DateTime?
  revoked_by         String?   @db.NVarChar(255)

  document   SgcDocument @relation(fields: [id_document], references: [id_document], onDelete: NoAction, onUpdate: NoAction)
  department Department? @relation(fields: [id_department], references: [id_department], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_document])
  @@map("document_access")
  @@schema("sgc")
}

// Registro de auditoría del SGC: SOLO INSERCIÓN. Un trigger INSTEAD OF
// UPDATE, DELETE (migración 20260930150000_sgc_s1_repositorio) rechaza
// cualquier cambio o borrado, sin importar el usuario de base de datos.
model SgcAuditLog {
  id_audit_log  BigInt   @id @default(autoincrement())
  id_company    Int?
  occurred_at   DateTime @default(now())
  actor_email   String?  @db.NVarChar(255)
  action        String   @db.NVarChar(80)
  entity        String   @db.NVarChar(60)
  entity_id     String?  @db.NVarChar(60)
  ip            String?  @db.NVarChar(64)
  user_agent    String?  @db.NVarChar(400)
  before_json   String?  @db.NVarChar(Max)
  after_json    String?  @db.NVarChar(Max)
  detail        String?  @db.NVarChar(1000)

  @@index([entity, entity_id])
  @@index([id_company, occurred_at])
  @@map("audit_log")
  @@schema("sgc")
}

// ---------------------------------------------------------------------------
// SGC documental — Sprint 2: administración de flujos validados, Tareas
// documentales y Autorizaciones SGC (esquema `sgc`).
//
// COPIA CONGELADA, en tablas propias, del motor de flujos, de la vista interna
// de solicitudes y del mecanismo de autorizaciones de SynerLink general (plan,
// estrategia B): nada de esto lee ni escribe process_category,
// task_process_category, requests_general, task_request_general, notes ni
// types_authorization. Las personas se guardan por correo (como en el S1).
// ---------------------------------------------------------------------------

// Proceso validado (documental; a futuro control de cambios, desviaciones,
// CAPA…). Su definición vive en versiones (SgcFlowVersion).
model SgcFlowProcess {
  id_flow_process Int      @id @default(autoincrement())
  id_company      Int
  code            String   @db.NVarChar(20)
  name            String   @db.NVarChar(200)
  description     String?  @db.NVarChar(1000)
  // documental | control_cambios | desviaciones | capa | capacitacion | auditorias | otro
  category        String   @default("documental") @db.NVarChar(30)
  owner_email     String?  @db.NVarChar(255)
  is_active       Boolean  @default(true)
  created_by      String   @db.NVarChar(255)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  companyConfig SgcCompanyConfig @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  versions      SgcFlowVersion[]
  requests      SgcRequest[]

  @@unique([id_company, code])
  @@map("flow_process")
  @@schema("sgc")
}

// Versión de la definición de un flujo: borrador → vigente → retirada. Solo
// se edita un BORRADOR; publicar deja la anterior retirada. Una instancia en
// curso conserva la versión con la que arrancó (SgcRequest.id_flow_version).
model SgcFlowVersion {
  id_flow_version Int       @id @default(autoincrement())
  id_flow_process Int
  version_number  Int
  // borrador | vigente | retirada
  status          String    @default("borrador") @db.NVarChar(20)
  change_reason   String    @db.NVarChar(1000)
  created_by      String    @db.NVarChar(255)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  published_by    String?   @db.NVarChar(255)
  published_at    DateTime?
  retired_at      DateTime?

  process     SgcFlowProcess      @relation(fields: [id_flow_process], references: [id_flow_process], onDelete: NoAction, onUpdate: NoAction)
  tasks       SgcFlowTaskDef[]
  transitions SgcFlowTransition[]
  formFields  SgcFlowFormField[]
  requests    SgcRequest[]

  @@unique([id_flow_process, version_number])
  @@map("flow_version")
  @@schema("sgc")
}

// Tarea (paso) de una versión del flujo.
model SgcFlowTaskDef {
  id_flow_task_def             Int     @id @default(autoincrement())
  id_flow_version              Int
  task_key                     String  @db.NVarChar(40)
  name                         String  @db.NVarChar(150)
  step_order                   Int
  // solicitante | elaborador | revisor | aprobador | calidad | alcance | capacitacion
  role                         String  @db.NVarChar(30)
  // solicitante | elaborador | firmantes (los asigna el elaborador) | calidad
  assignment                   String  @db.NVarChar(30)
  multi_assignee               Boolean @default(false)
  // orden | paralelo (modo por defecto; el documento puede elegir otro)
  signing_mode_default         String? @db.NVarChar(20)
  // elaboro | reviso | aprobo | leyo | capacito (punto de firma; la firma propia llega en el S3)
  signature_meaning            String? @db.NVarChar(20)
  target_days                  Int?
  // Condición para ejecutar la tarea (null = siempre), ver lib/sgc/flows/definition.ts.
  condition_key                String? @db.NVarChar(60)
  // Tarea de autorización (llega también a la bandeja Autorizaciones SGC).
  is_authorization             Boolean @default(false)
  authorization_type_code      String? @db.NVarChar(40)
  // Verificación por un GRUPO de autorización (p.ej. Aseguramiento de Calidad).
  pool_authorization_type_code String? @db.NVarChar(40)
  // false = la tarea existe en la definición pero el motor aún no la ejecuta
  // (queda "en espera"; p.ej. divulgación y capacitación hasta el Sprint 4).
  is_enabled                   Boolean @default(true)
  description                  String? @db.NVarChar(1000)

  version SgcFlowVersion @relation(fields: [id_flow_version], references: [id_flow_version], onDelete: NoAction, onUpdate: NoAction)
  tasks   SgcTask[]

  @@unique([id_flow_version, task_key])
  @@map("flow_task_def")
  @@schema("sgc")
}

// Transición entre tareas: acción (aprobar | devolver | cancelar) y destino
// (to_task_key) o cierre (terminal_status: completada | cancelada).
model SgcFlowTransition {
  id_flow_transition Int     @id @default(autoincrement())
  id_flow_version    Int
  from_task_key      String  @db.NVarChar(40)
  action             String  @db.NVarChar(20)
  to_task_key        String? @db.NVarChar(40)
  terminal_status    String? @db.NVarChar(20)

  version SgcFlowVersion @relation(fields: [id_flow_version], references: [id_flow_version], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_flow_version, from_task_key, action])
  @@map("flow_transition")
  @@schema("sgc")
}

// Campo de formulario de la solicitud (task_key null) o de una tarea.
model SgcFlowFormField {
  id_flow_form_field Int     @id @default(autoincrement())
  id_flow_version    Int
  task_key           String? @db.NVarChar(40)
  field_key          String  @db.NVarChar(40)
  label              String  @db.NVarChar(150)
  // texto | texto_largo | numero | fecha | seleccion | si_no
  field_type         String  @db.NVarChar(20)
  required           Boolean @default(false)
  options_json       String? @db.NVarChar(Max)
  help_text          String? @db.NVarChar(500)
  sort_order         Int     @default(0)

  version    SgcFlowVersion @relation(fields: [id_flow_version], references: [id_flow_version], onDelete: NoAction, onUpdate: NoAction)
  formValues SgcFormValue[]

  @@unique([id_flow_version, task_key, field_key])
  @@map("flow_form_field")
  @@schema("sgc")
}

// Matriz de responsables: SOLO SUGIERE quién elabora, revisa y aprueba por
// proceso/área y tipo documental (por persona o por cargo). El elaborador
// decide. Nada se borra: se desactiva con motivo (registro de cambios).
model SgcResponsibleMatrix {
  id_responsible   Int      @id @default(autoincrement())
  id_company       Int
  id_process_map   Int?
  id_document_type Int?
  // elaborador | revisor | aprobador
  role             String   @db.NVarChar(20)
  user_email       String?  @db.NVarChar(255)
  id_cargo         Int?
  cargo_name       String?  @db.NVarChar(200)
  sort_order       Int      @default(0)
  is_active        Boolean  @default(true)
  is_example       Boolean  @default(false)
  updated_by       String   @db.NVarChar(255)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  companyConfig SgcCompanyConfig @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  process       SgcProcessMap?   @relation(fields: [id_process_map], references: [id_process_map], onDelete: NoAction, onUpdate: NoAction)
  documentType  SgcDocumentType? @relation(fields: [id_document_type], references: [id_document_type], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_company, role])
  @@map("responsible_matrix")
  @@schema("sgc")
}

// Registro de cambios de configuración de flujos, matriz y autorizaciones:
// SOLO INSERCIÓN (trigger que rechaza UPDATE y DELETE). Quién, cuándo, qué
// (antes/después), motivo y referencia al control de cambios.
model SgcConfigChangeLog {
  id_config_change BigInt   @id @default(autoincrement())
  id_company       Int
  occurred_at      DateTime @default(now())
  actor_email      String   @db.NVarChar(255)
  entity           String   @db.NVarChar(40)
  entity_id        String?  @db.NVarChar(60)
  id_flow_process  Int?
  id_flow_version  Int?
  action           String   @db.NVarChar(40)
  reason           String   @db.NVarChar(1000)
  change_reference String?  @db.NVarChar(100)
  before_json      String?  @db.NVarChar(Max)
  after_json       String?  @db.NVarChar(Max)
  ip               String?  @db.NVarChar(64)
  user_agent       String?  @db.NVarChar(400)

  @@index([id_company, occurred_at])
  @@index([entity, entity_id])
  @@map("config_change_log")
  @@schema("sgc")
}

// Instancia de un flujo validado. Para el documental: la solicitud documental.
model SgcRequest {
  id_request         Int       @id @default(autoincrement())
  id_company         Int
  id_flow_process    Int
  id_flow_version    Int
  // nuevo | nueva_version | modificacion (documental)
  request_type       String    @db.NVarChar(30)
  subject            String    @db.NVarChar(300)
  description        String    @db.NVarChar(Max)
  id_document        Int?
  id_process_map     Int?
  id_document_type   Int?
  requester_email    String    @db.NVarChar(255)
  elaborator_email   String    @db.NVarChar(255)
  // {"revision":"paralelo","aprobacion":"orden"} — modo de firma por paso, elegido en el documento.
  signing_modes_json String    @default("{}") @db.NVarChar(1000)
  // abierta | en_espera | completada | cancelada
  status             String    @default("abierta") @db.NVarChar(20)
  current_task_key   String?   @db.NVarChar(40)
  cancel_reason      String?   @db.NVarChar(1000)
  closed_by          String?   @db.NVarChar(255)
  closed_at          DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  companyConfig  SgcCompanyConfig   @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  process        SgcFlowProcess     @relation(fields: [id_flow_process], references: [id_flow_process], onDelete: NoAction, onUpdate: NoAction)
  version        SgcFlowVersion     @relation(fields: [id_flow_version], references: [id_flow_version], onDelete: NoAction, onUpdate: NoAction)
  document       SgcDocument?       @relation(fields: [id_document], references: [id_document], onDelete: NoAction, onUpdate: NoAction)
  processMap     SgcProcessMap?     @relation(fields: [id_process_map], references: [id_process_map], onDelete: NoAction, onUpdate: NoAction)
  documentType   SgcDocumentType?   @relation(fields: [id_document_type], references: [id_document_type], onDelete: NoAction, onUpdate: NoAction)
  tasks          SgcTask[]
  signers        SgcRequestSigner[]
  formValues     SgcFormValue[]
  interactions   SgcInteraction[]
  attachments    SgcAttachment[]
  authorizations SgcAuthorization[]

  @@index([id_company, status])
  @@index([requester_email])
  @@map("request")
  @@schema("sgc")
}

// Firmantes configurados por el ELABORADOR para un paso (revisión,
// aprobación), con su orden. No se borran: se retiran con quién, cuándo y por qué.
model SgcRequestSigner {
  id_request_signer Int       @id @default(autoincrement())
  id_request        Int
  step_key          String    @db.NVarChar(40)
  user_email        String    @db.NVarChar(255)
  sign_order        Int
  is_active         Boolean   @default(true)
  added_by          String    @db.NVarChar(255)
  added_at          DateTime  @default(now())
  removed_by        String?   @db.NVarChar(255)
  removed_at        DateTime?
  change_reason     String?   @db.NVarChar(1000)

  request SgcRequest @relation(fields: [id_request], references: [id_request], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_request, step_key])
  @@map("request_signer")
  @@schema("sgc")
}

// Tarea de una instancia (una por paso y por ronda: devolver abre una ronda nueva).
model SgcTask {
  id_task          Int       @id @default(autoincrement())
  id_request       Int
  id_flow_task_def Int
  task_key         String    @db.NVarChar(40)
  name             String    @db.NVarChar(150)
  step_order       Int
  round            Int       @default(1)
  // sin_empezar | abierta | resuelta | devuelta | cancelada | en_espera
  status           String    @db.NVarChar(20)
  // orden | paralelo (solo tareas con varios firmantes)
  signing_mode     String?   @db.NVarChar(20)
  started_at       DateTime?
  ended_at         DateTime?
  resolution       String?   @db.NVarChar(2000)
  resolved_by      String?   @db.NVarChar(255)
  created_at       DateTime  @default(now())

  request   SgcRequest        @relation(fields: [id_request], references: [id_request], onDelete: NoAction, onUpdate: NoAction)
  taskDef   SgcFlowTaskDef    @relation(fields: [id_flow_task_def], references: [id_flow_task_def], onDelete: NoAction, onUpdate: NoAction)
  assignees SgcTaskAssignee[]

  @@index([id_request])
  @@map("task")
  @@schema("sgc")
}

// Responsable (firmante) de una tarea. user_email null = cupo de un GRUPO de
// autorización (lo toma cualquiera del grupo). Guarda la decisión y el punto de
// firma (la firma electrónica propia llega en el Sprint 3).
model SgcTaskAssignee {
  id_task_assignee  Int       @id @default(autoincrement())
  id_task           Int
  user_email        String?   @db.NVarChar(255)
  pool_type_code    String?   @db.NVarChar(40)
  sign_order        Int       @default(1)
  // pendiente | aprobado | devuelto | reemplazado | anulado
  status            String    @default("pendiente") @db.NVarChar(20)
  decided_by        String?   @db.NVarChar(255)
  decided_at        DateTime?
  comment           String?   @db.NVarChar(2000)
  // no_aplica | pendiente_s3 | firmada
  signature_status  String    @default("no_aplica") @db.NVarChar(20)
  signature_meaning String?   @db.NVarChar(20)
  notified_at       DateTime?
  created_at        DateTime  @default(now())

  task           SgcTask            @relation(fields: [id_task], references: [id_task], onDelete: NoAction, onUpdate: NoAction)
  authorizations SgcAuthorization[]

  @@index([id_task])
  @@index([user_email, status])
  @@map("task_assignee")
  @@schema("sgc")
}

model SgcFormValue {
  id_form_value      Int      @id @default(autoincrement())
  id_request         Int
  id_flow_form_field Int
  value_text         String?  @db.NVarChar(Max)
  updated_by         String   @db.NVarChar(255)
  updated_at         DateTime @updatedAt

  request SgcRequest       @relation(fields: [id_request], references: [id_request], onDelete: NoAction, onUpdate: NoAction)
  field   SgcFlowFormField @relation(fields: [id_flow_form_field], references: [id_flow_form_field], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_request, id_flow_form_field])
  @@map("form_value")
  @@schema("sgc")
}

// Historial PROPIO de interacciones (equivalente aislado de dbo.notes): notas,
// cambios de estado, adjuntos, reasignaciones, cambios de firmantes,
// devoluciones y decisiones. SOLO INSERCIÓN (trigger).
model SgcInteraction {
  id_interaction BigInt   @id @default(autoincrement())
  id_request     Int
  id_task        Int?
  // nota | estado | adjunto | reasignacion | firmantes | devolucion | cancelacion | decision | sistema
  kind           String   @db.NVarChar(20)
  author_email   String   @db.NVarChar(255)
  body           String   @db.NVarChar(Max)
  meta_json      String?  @db.NVarChar(Max)
  notify_emails  String?  @db.NVarChar(2000)
  created_at     DateTime @default(now())

  request SgcRequest @relation(fields: [id_request], references: [id_request], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_request, created_at])
  @@map("interaction")
  @@schema("sgc")
}

// Adjuntos de la solicitud en OneDrive (carpeta propia de la empresa). No se
// borran: se retiran (withdrawn_at) con motivo.
model SgcAttachment {
  id_attachment   Int       @id @default(autoincrement())
  id_request      Int
  id_task         Int?
  // borrador (documento en elaboración) | soporte
  purpose         String    @default("soporte") @db.NVarChar(20)
  file_name       String    @db.NVarChar(260)
  item_id         String    @db.NVarChar(200)
  storage_path    String    @db.NVarChar(600)
  content_type    String    @db.NVarChar(150)
  size_bytes      Int
  sha256          String    @db.Char(64)
  uploaded_by     String    @db.NVarChar(255)
  created_at      DateTime  @default(now())
  withdrawn_at    DateTime?
  withdrawn_by    String?   @db.NVarChar(255)
  withdraw_reason String?   @db.NVarChar(1000)

  request SgcRequest @relation(fields: [id_request], references: [id_request], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_request])
  @@map("attachment")
  @@schema("sgc")
}

// Autorizaciones SGC — COPIA CONGELADA del mecanismo de autorizaciones de
// SynerLink (types_authorization / user_types_authorization / tareas de
// autorización), en tablas propias. No usa el tipo "Autorización de
// documento" (id 8) de SynerLink general.
model SgcAuthorizationType {
  id_authorization_type Int      @id @default(autoincrement())
  id_company            Int
  code                  String   @db.NVarChar(40)
  name                  String   @db.NVarChar(150)
  description           String?  @db.NVarChar(1000)
  is_active             Boolean  @default(true)
  updated_by            String   @db.NVarChar(255)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  companyConfig  SgcCompanyConfig           @relation(fields: [id_company], references: [id_company], onDelete: NoAction, onUpdate: NoAction)
  users          SgcAuthorizationTypeUser[]
  authorizations SgcAuthorization[]

  @@unique([id_company, code])
  @@map("authorization_type")
  @@schema("sgc")
}

// Quién pertenece al grupo de un tipo de autorización. No se borra: se revoca.
model SgcAuthorizationTypeUser {
  id_authorization_type_user Int       @id @default(autoincrement())
  id_authorization_type      Int
  user_email                 String    @db.NVarChar(255)
  granted_by                 String    @db.NVarChar(255)
  reason                     String    @db.NVarChar(1000)
  created_at                 DateTime  @default(now())
  revoked_at                 DateTime?
  revoked_by                 String?   @db.NVarChar(255)

  type SgcAuthorizationType @relation(fields: [id_authorization_type], references: [id_authorization_type], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_authorization_type])
  @@map("authorization_type_user")
  @@schema("sgc")
}

// Registro de cada autorización pedida (una por firmante y ronda).
model SgcAuthorization {
  id_authorization      Int       @id @default(autoincrement())
  id_company            Int
  id_authorization_type Int
  id_request            Int
  id_task_assignee      Int
  // null = la puede tomar cualquiera del grupo del tipo
  assigned_email        String?   @db.NVarChar(255)
  // pendiente | autorizada | rechazada | anulada
  status                String    @default("pendiente") @db.NVarChar(20)
  requested_at          DateTime  @default(now())
  decided_by            String?   @db.NVarChar(255)
  decided_at            DateTime?
  decision_comment      String?   @db.NVarChar(2000)

  type     SgcAuthorizationType @relation(fields: [id_authorization_type], references: [id_authorization_type], onDelete: NoAction, onUpdate: NoAction)
  request  SgcRequest           @relation(fields: [id_request], references: [id_request], onDelete: NoAction, onUpdate: NoAction)
  assignee SgcTaskAssignee      @relation(fields: [id_task_assignee], references: [id_task_assignee], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_company, status])
  @@index([assigned_email, status])
  @@map("authorization")
  @@schema("sgc")
}
